{
  "name": "mimosa",
  "version": "0.1.0",
  "private": true,
  "description": "A focused macOS PDF reader for everyday work.",
  "main": "dist-electron/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "tsc -b && vite build && npm run build:electron",
    "test": "vitest",
    "test:e2e": "npm run build:electron && playwright test",
    "test:packaged": "playwright test --config=playwright.packaged.config.ts",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "com.fewfy.mimosa",
    "productName": "Mimosa",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "mac": {
      "icon": "assets/mimosa.icns",
      "target": [
        "dmg"
      ]
    }
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1"
  }
}
